# Copy to .env and fill in. Never commit .env.
APP_NAME=PeerPrep API
API_PREFIX=/api
# "production" disables the interactive API docs and enables HSTS
ENVIRONMENT=development

DATABASE_URL=sqlite:///./peerprep.db
CORS_ORIGINS=http://localhost:5173
# Optional regex for extra origins (e.g. Vercel preview URLs)
CORS_ORIGIN_REGEX=

BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173

# Signs login tokens. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Verification emails (SMTP). Leave empty to show the verification link on screen instead.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=
EMAIL_PASS=
# Show the verification link when an email can't be sent. Set to false once email works in production.
VERIFY_LINK_FALLBACK=true

# Optional: enables the AI writing and cover-image helpers
OPENAI_API_KEY=

# Owner of the sample events. Use a strong password (12+ characters) or leave empty for a random one.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
